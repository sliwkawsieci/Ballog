* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method zcl_appl_log->DISPLAY
* +-------------------------------------------------------------------------------------------------+
* | [--->] IV_DISPLFLAG                   TYPE        FLAG(optional)
* | [--->] IS_DISPLAY_PROFILE             TYPE        BAL_S_PROF(optional)
* +--------------------------------------------------------------------------------------</SIGNATURE>
METHOD display.
* ------------------------------------------------------------------

  DATA: lt_log_handle TYPE bal_t_logh.
  DATA: ls_statistics TYPE bal_s_scnt.

* ------------------------------------------------------------------

  "Temporär keine Meldungsanzeige für den Wartungsplanmanager
  CHECK sy-tcode <> 'ZIR_WP02'.
  CHECK sy-tcode <> 'ZIR_WP03'.

  CALL FUNCTION 'BAL_LOG_HDR_READ'
    EXPORTING
      i_log_handle = mv_log_handle
    IMPORTING
      e_statistics = ls_statistics.

  CHECK ls_statistics-msg_cnt_al > 0.

  CASE iv_displflag.
    WHEN ''.
      IF  ls_statistics-msg_cnt_al = 1.
        "Bei nur einer Meldung kein Applog-Popup
        MESSAGE ID sy-msgid
          TYPE
            'W' " sy-msgty
          NUMBER
            sy-msgno
          WITH
            sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ELSE.
        APPEND mv_log_handle TO lt_log_handle.

        CALL FUNCTION 'BAL_DSP_LOG_DISPLAY'
          EXPORTING
            i_t_log_handle = lt_log_handle
            i_amodal       = 'X'.
      ENDIF.
    WHEN '1'.
      "Immer im neuen Modus
      APPEND mv_log_handle TO lt_log_handle.

      CALL FUNCTION 'BAL_DSP_LOG_DISPLAY'
        EXPORTING
          i_t_log_handle = lt_log_handle
          i_amodal       = 'X'.
    WHEN '2'.
      IF  ls_statistics-msg_cnt_al = 1.
        "Bei nur einer Meldung kein Applog-Popup
        MESSAGE ID sy-msgid
          TYPE
            sy-msgty
          NUMBER
            sy-msgno
          WITH
            sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ELSE.
        "Popup
        APPEND mv_log_handle TO lt_log_handle.

        CALL FUNCTION 'BAL_DSP_LOG_DISPLAY'
          EXPORTING
            i_s_display_profile = Is_display_profile
            i_t_log_handle      = lt_log_handle
            i_amodal            = ' '.
      ENDIF.
  ENDCASE.
ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method zcl_appl_log->HAS_ERROR
* +-------------------------------------------------------------------------------------------------+
* | [<-()] RV_VALUE                       TYPE        ABAP_BOOL
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD has_error.
*----------------------------------------------------------------------*
* SBB AG, SAP CCC-IT, Bern/Berne/Berna
*----------------------------------------------------------------------*
* Beschreibung/description: Check whether the log has an error
*
* SAP-Prozess/process : ...
* Grund/reason: ( ) QM-Meldung/QM ticket  : ...
*               ( ) Projekt/ project      : 9459:APU:Ultraschallkontrolle
*               ( ) Notkorrektur/ emergency correction: ...
*               ( ) OSS-Hinweis/note      : ...
*               ( ) OSS-Meldung/message   : ...
*               ( ) andere/other          : ...
*
* Auftraggeber/ ordered by: ...
*
*--------------Änderungsdokumentation/ documentation of changes--------*
* Version SAP-Rel    Datum/date        Entwickler/developer
*         Beschreibung/ description
*----------------------------------------------------------------------*
* >000<   7.52       04.03.2021   DXC / Piotr Stelmach
*         Programmerstellung/ APU-5351
*----------------------------------------------------------------------*
    DATA(lt_msg) = VALUE bal_t_msgr( ).

    CALL FUNCTION 'BAL_LOG_READ'
      EXPORTING
        i_log_handle  = mv_log_handle
      IMPORTING
        et_msg        = lt_msg
      EXCEPTIONS
        log_not_found = 1
        OTHERS        = 2.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    IF line_exists( lt_msg[ msgty = zif_ia_const=>mc_msgty-_e ] ) OR
       line_exists( lt_msg[ msgty = zif_ia_const=>mc_msgty-_a ] ) OR
       line_exists( lt_msg[ msgty = zif_ia_const=>mc_msgty-_x ] ).
      rv_value = abap_true.
    ENDIF.

  ENDMETHOD.


