  PUBLIC SECTION.


       METHODS constructor
      IMPORTING
        !iv_object    TYPE balobj_d
        !iv_subobject TYPE balsubobj
        !iv_extnumber TYPE balnrext .
    METHODS: add_sy_msg ,
      download_inital_messages
        IMPORTING
          !iv_object    TYPE balobj_d
          !iv_subobject TYPE balsubobj
          !iv_extnumber TYPE balnrext
          iv_data       TYPE sy-datum OPTIONAL .
    METHODS add_bapiret IMPORTING
                          !is_bapiret2 TYPE bapiret2.
    METHODS has_error
      RETURNING
        VALUE(rv_value) TYPE abap_bool .
    METHODS msg_add
      IMPORTING
        !iv_msgty TYPE sy-msgty
        !iv_msgid TYPE sy-msgid
        !iv_msgno TYPE sy-msgno
        !iv_msgv1 TYPE sy-msgv1
        !iv_msgv2 TYPE sy-msgv2
        !iv_msgv3 TYPE sy-msgv3
        !iv_msgv4 TYPE sy-msgv4 .
    METHODS save .
    METHODS display
      IMPORTING
        !iv_show_tree     TYPE sap_bool OPTIONAL
        !iv_standard_disp TYPE sap_bool OPTIONAL .
    METHODS add_message_ex
