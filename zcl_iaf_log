CLASS zcl_iaf_log DEFINITION
  PUBLIC
  INHERITING FROM zcl_fram_logger
  CREATE PUBLIC .

  PUBLIC SECTION.

    INTERFACES zif_iaf_log .

    ALIASES get_iaf_context
      FOR zif_iaf_log~get_iaf_context .

    TYPES:
      BEGIN OF ty_persn_cond,
        pernr    TYPE persno,
        ex       TYPE REF TO zcx_fram_log_exc,
        type     TYPE  syst_msgty,
        detlevel TYPE ballevel,
        context  TYPE bal_s_cont,
      END OF ty_persn_cond .
    TYPES:
      BEGIN OF ty_persn_infty,
        pernr    TYPE persno,
        subty    TYPE subty,
        infty    TYPE infty,
        ex       TYPE REF TO zcx_fram_log_exc,
        type     TYPE  syst_msgty,
        detlevel TYPE ballevel,
        context  TYPE bal_s_cont,
      END OF ty_persn_infty .
    TYPES:
      tt_persn_infty TYPE TABLE OF ty_persn_infty .
    TYPES:
      tt_persn_cond  TYPE TABLE OF ty_persn_cond .

    TYPES: BEGIN OF ty_ballog_ext.
             INCLUDE TYPE ziaf_s_ballog_ext.
             TYPES: value TYPE balcval,
           END OF ty_ballog_ext.
    CLASS-DATA mt_msg_ballog_ext TYPE TABLE OF ty_ballog_ext .

    METHODS constructor
      IMPORTING
        !iv_object       TYPE balobj_d
        !iv_subobject    TYPE balsubobj
        !iv_extnumber    TYPE balnrext OPTIONAL
        !iv_cumulate_msg TYPE abap_bool DEFAULT abap_true .

    METHODS:
      zif_logger~save REDEFINITION,
      zif_logger~add_message
        REDEFINITION .
    METHODS zif_logger~add_message_ex
        REDEFINITION .
    METHODS zif_logger~add_sy_msg
        REDEFINITION .
    METHODS zif_logger~display
        REDEFINITION .
  PROTECTED SECTION.

    METHODS adjust_tree_profile
      CHANGING
        !cs_profile TYPE bal_s_prof .

    METHODS msg_add
        REDEFINITION .
*"* protected components of class zcl_appl_log
*"* do not include other source files here!!!
  PRIVATE SECTION.
    DATA: mt_messages_for_pernr       TYPE tt_persn_cond,
          mt_messages_per_pernr_infty TYPE tt_persn_infty.
*"* private components of class zcl_appl_log
*"* do not include other source files here!!!
