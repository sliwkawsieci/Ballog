*      iv_msgv2 = io_exception->msgv2
*      iv_msgv3 = io_exception->msgv3
*      iv_msgv4 = io_exception->msgv4 ).

  ENDMETHOD.


  METHOD zif_logger~add_text.
    DATA: lv_msgv1 TYPE sy-msgv1,
          lv_msgv2 TYPE sy-msgv2,
          lv_msgv3 TYPE sy-msgv3,
          lv_msgv4 TYPE sy-msgv4.

    DATA(lv_type) = COND syst_msgty( WHEN iv_type IS INITIAL THEN 'I' ELSE iv_type ).

    lv_msgv1 = iv_txt(50).
    lv_msgv2 = iv_txt+50(50).
    lv_msgv3 = iv_txt+100(50).
    lv_msgv4 = iv_txt+150(50).

    me->msg_add(
      iv_msgty    = lv_type
      iv_msgid    = '00'
      iv_msgno    = 001
      iv_msgv1    = lv_msgv1
      iv_msgv2    = lv_msgv2
      iv_msgv3    = lv_msgv3
      iv_msgv4    = lv_msgv4
    ).
  ENDMETHOD.


  METHOD zif_logger~get_messages_list.
    DATA: lt_msg TYPE bal_t_msgr.


    CALL FUNCTION 'BAL_LOG_READ'
      EXPORTING
        i_log_handle  = mv_log_handle
      IMPORTING
        et_msg        = lt_msg
      EXCEPTIONS
        log_not_found = 1
        OTHERS        = 2.

    LOOP AT lt_msg ASSIGNING FIELD-SYMBOL(<ls_msg>).
      APPEND INITIAL LINE TO rt_log_msg ASSIGNING FIELD-SYMBOL(<ls_out>).
      MOVE-CORRESPONDING <ls_msg> TO <ls_out>.
    ENDLOOP.
  ENDMETHOD.


  METHOD zif_logger~save.
*--------------------------------------------------------------------*

    DATA: ls_statistics            TYPE          bal_s_scnt.
    DATA: lt_object_with_lognumber TYPE TABLE OF balnri.

*--------------------------------------------------------------------*

    CALL FUNCTION 'BAL_LOG_HDR_READ'
      EXPORTING
        i_log_handle = mv_log_handle
      IMPORTING
        e_statistics = ls_statistics.

    IF NOT ls_statistics-msg_cnt_al > 0.
      RETURN.
    ENDIF.

    CALL FUNCTION 'APPL_LOG_WRITE_DB'
      EXPORTING
        log_handle            = mv_log_handle
        update_task           = abap_false
      TABLES
        object_with_lognumber = lt_object_with_lognumber.

  ENDMETHOD.
ENDCLASS.
