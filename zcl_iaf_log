CLASS ltcl_unit_check DEFINITION FOR TESTING RISK LEVEL HARMLESS DURATION SHORT.

  PRIVATE SECTION.
    METHODS:
      sh_rais_exc_for_errors_in_prnr FOR TESTING,
      sh_rais_exc_for_errors_in_inft FOR TESTING ,"RAISING cx_static_check.
      sh_rais_exc_for_get_iaf_cont FOR TESTING ,
      sh_rais_exc_upd_msg_per_in_tab FOR TESTING,
      sh_rais_exc_log_msgs_per_tab FOR TESTING,
      sh_rais_exc_add_message_ex FOR TESTING,
      add_message_with_error FOR TESTING RAISING cx_static_check,
      add_message_ex FOR TESTING RAISING cx_static_check.

ENDCLASS.


CLASS ltcl_unit_check IMPLEMENTATION.

  METHOD add_message_ex.
    DATA(lo_sub) = NEW zcl_iaf_log_null( ).
    lo_sub->add_message_ex( ir_ex = NEW zcx_fram_log_exc( ) iv_type = zcl_iaf_const=>c_msg_type-error ).
    lo_sub->add_static_exception(
      EXPORTING
        io_exception =  NEW zcx_fram_log_exc( )
*        iv_type      = 'E'
    ).
  ENDMETHOD.

  METHOD add_message_with_error.
    DATA(lo_sub) = NEW zcl_iaf_log_null( ).
    MESSAGE e001(ziaf) INTO DATA(lv_duimmy).
    lo_sub->add_sy_msg( ).
    DATA(ls_context) = lo_sub->mt_msg_ballog_ext.
    cl_abap_unit_assert=>assert_equals( act = lo_sub->has_error( ) exp = abap_true ).
  ENDMETHOD.

  METHOD sh_rais_exc_for_errors_in_inft.
    DATA: lo_subject TYPE REF TO zif_iaf_log.
    TRY.
        lo_subject = NEW zcl_iaf_log( iv_object = '' iv_subobject = ''  ).

        lo_subject->add_message_pernr_inft_table( ir_ex = NEW #( ) iv_pernr = '20000008' iv_infty = '0014' iv_type = zcl_iaf_const=>c_msg_type-error iv_subty = '7000').
        lo_subject->add_message_pernr_inft_table( ir_ex = NEW #( ) iv_pernr = '20000008' iv_infty = '0015' iv_type = zcl_iaf_const=>c_msg_type-error iv_subty = '' ).

        lo_subject->check_no_infotype_errors( VALUE pskey( infty = '0014' subty = '7000' pernr = '20000008' ) ).
        cl_abap_unit_assert=>fail( 'Should be an exception' ).
      CATCH zcx_iaf_config_error INTO DATA(lx_error).

        cl_abap_unit_assert=>assert_equals( act = lx_error->get_longtext( ) exp = 'Processing infotype 0014 subtype 7000 ended with error. Please check config.' ).
        "that's good.
    ENDTRY.
  ENDMETHOD.

  METHOD sh_rais_exc_for_errors_in_prnr.
    DATA: lo_subject TYPE REF TO zif_iaf_log.
    TRY.
        lo_subject = NEW zcl_iaf_log( iv_object = '' iv_subobject = ''  ).

        lo_subject->add_message_pernr_table( ir_ex = NEW #( ) iv_pernr = '20000008' ).
        lo_subject->add_message_pernr_table( ir_ex = NEW #( ) iv_pernr = '20000008'  ).

        lo_subject->check_no_pernr_errors( VALUE pskey( infty = '0014' subty = '7000' pernr = '20000008' ) ).
        cl_abap_unit_assert=>fail( 'Should be an exception' ).
      CATCH zcx_iaf_config_error INTO DATA(lx_error).

        "that's good.
    ENDTRY.
  ENDMETHOD.

  METHOD sh_rais_exc_for_get_iaf_cont.
    DATA: lo_subject TYPE REF TO zif_iaf_log.
    TRY.
        lo_subject = NEW zcl_iaf_log( iv_object = '' iv_subobject = ''  ).
        lo_subject->get_iaf_context( iv_pernr = '20000008' iv_infty = '0014' iv_subty = '7000').
        lo_subject->get_iaf_context( iv_subty = '' ).

        lo_subject->check_no_pernr_errors( VALUE pskey( infty = '0014' subty = '7000' pernr = '20000008' ) ).
        cl_abap_unit_assert=>fail( 'Should be an exception' ).
      CATCH zcx_iaf_config_error INTO DATA(lx_error).
    ENDTRY.
  ENDMETHOD.


  METHOD sh_rais_exc_upd_msg_per_in_tab.
    DATA: lo_subject TYPE REF TO zif_iaf_log.
    TRY.
        lo_subject = NEW zcl_iaf_log( iv_object = '' iv_subobject = ''  ).
        lo_subject->update_msgs_pernr_infty_tab( VALUE pskey( infty = '0014' subty = '7000' pernr = '20000008' ) ).
*        lo_subject->update_msgs_pernr_infty_tab( VALUE pskey( infty = '0014' subty = '7000' pernr = '20000008' ) ).

        lo_subject->check_no_infotype_errors( VALUE pskey( infty = '0014' subty = '7000' pernr = '20000008' ) ).
*        cl_abap_unit_assert=>fail( 'Should be an exception' ).
      CATCH zcx_iaf_config_error INTO DATA(lx_error).

        cl_abap_unit_assert=>assert_equals( act = lx_error->get_longtext( ) exp = 'Processing infotype 0014 subtype 7000 ended with error. Please check config.' ).
        "that's good.
    ENDTRY.
  ENDMETHOD.
  METHOD sh_rais_exc_log_msgs_per_tab.
    DATA: lo_subject TYPE REF TO zif_iaf_log.
    TRY.
        lo_subject = NEW zcl_iaf_log( iv_object = '' iv_subobject = ''  ).

        lo_subject->update_logs_from_msg_pernr_tab( iv_pernr = '20000008' ).
*        lo_subject->update_logs_from_msg_pernr_tab( iv_pernr = '20000008' ).

        lo_subject->check_no_pernr_errors( VALUE pskey( infty = '0014' subty = '7000' pernr = '20000008' ) ).
*        cl_abap_unit_assert=>fail( 'Should be an exception' ).
      CATCH zcx_iaf_config_error INTO DATA(lx_error).

        "that's good.
    ENDTRY.
  ENDMETHOD.

  METHOD  sh_rais_exc_add_message_ex.

    DATA:
      lo_initial_exception TYPE REF TO zcx_fram_log_exc,
      lo_subject           TYPE REF TO zif_iaf_log.
    TRY.
        lo_subject = NEW zcl_iaf_log( iv_object = '' iv_subobject = ''  ).
        lo_subject->add_message_ex( ir_ex = lo_initial_exception  iv_type = zcl_iaf_const=>c_msg_type-error ).
        cl_abap_unit_assert=>fail( 'Should be raising exception zcx_iaf_log' ).
      CATCH zcx_fram_obj_no_bound.
        "Expected exception
    ENDTRY.
  ENDMETHOD.


ENDCLASS.
